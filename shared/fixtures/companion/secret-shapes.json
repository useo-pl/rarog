{
  "about": "Secret shapes the voice agent masks before text leaves for an outside AI: the ask route's answer on the server (server/src/companion/mask.ts) and the session projection in the app. A sieve for common shapes, not a guarantee: a secret in any other shape passes. Rules apply in this order; every example is synthetic. Patterns use the syntax both JavaScript RegExp and NSRegularExpression accept.",
  "mask": "[secret]",
  "rules": [
    {
      "name": "rarog-device",
      "pattern": "(Rarog-Device)\\s+[^\\s\"',;]+",
      "caseInsensitive": true,
      "replacement": "$1 [secret]"
    },
    {
      "name": "bearer",
      "pattern": "\\b(Bearer)\\s+[A-Za-z0-9._~+/=-]{16,}",
      "caseInsensitive": true,
      "replacement": "$1 [secret]"
    },
    {
      "name": "sk-key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{20,}",
      "caseInsensitive": false,
      "replacement": "[secret]"
    },
    {
      "name": "github-token",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})",
      "caseInsensitive": false,
      "replacement": "[secret]"
    },
    {
      "name": "aws-access-key-id",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "caseInsensitive": false,
      "replacement": "[secret]"
    },
    {
      "name": "slack-token",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "caseInsensitive": false,
      "replacement": "[secret]"
    }
  ],
  "cases": [
    {
      "rule": "rarog-device",
      "example": "Authorization: Rarog-Device 0123456789abcdef0123456789abcdef.EXAMPLEexampleEXAMPLEexample",
      "expected": "Authorization: Rarog-Device [secret]"
    },
    {
      "rule": "rarog-device",
      "example": "header 'rarog-device abc.def', then",
      "expected": "header 'rarog-device [secret]', then"
    },
    {
      "rule": "bearer",
      "example": "curl -H \"Authorization: Bearer EXAMPLEexampleEXAMPLE.example\" https://api.example.com",
      "expected": "curl -H \"Authorization: Bearer [secret]\" https://api.example.com"
    },
    {
      "rule": "bearer",
      "example": "bearer EXAMPLEexampleEXAMPLE in lower case",
      "expected": "bearer [secret] in lower case"
    },
    {
      "rule": "bearer",
      "example": "Bearer tokens are short-lived",
      "expected": "Bearer tokens are short-lived"
    },
    {
      "rule": "sk-key",
      "example": "OPENAI_API_KEY=sk-EXAMPLEexampleEXAMPLEexampleEXAMPLE",
      "expected": "OPENAI_API_KEY=[secret]"
    },
    {
      "rule": "sk-key",
      "example": "key sk-proj-EXAMPLE_example-EXAMPLEexampleEXAMPLE in the log",
      "expected": "key [secret] in the log"
    },
    {
      "rule": "sk-key",
      "example": "task-runner and sk-short stay",
      "expected": "task-runner and sk-short stay"
    },
    {
      "rule": "github-token",
      "example": "GH_TOKEN=ghp_000000000000000000000000000000000000",
      "expected": "GH_TOKEN=[secret]"
    },
    {
      "rule": "github-token",
      "example": "token github_pat_EXAMPLEexample_EXAMPLEexampleEXAMPLE done",
      "expected": "token [secret] done"
    },
    {
      "rule": "aws-access-key-id",
      "example": "aws_access_key_id = AKIAEXAMPLEEXAMPLE00",
      "expected": "aws_access_key_id = [secret]"
    },
    {
      "rule": "aws-access-key-id",
      "example": "AKIAEXAMPLE is too short",
      "expected": "AKIAEXAMPLE is too short"
    },
    {
      "rule": "slack-token",
      "example": "SLACK_TOKEN=xoxb-0000000000-EXAMPLEexample",
      "expected": "SLACK_TOKEN=[secret]"
    }
  ]
}
