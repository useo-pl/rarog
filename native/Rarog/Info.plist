<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Rarog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pl</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.rarog.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rarog</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>The camera turns on only when you tap “Scan QR Code” to pair with a server: the app reads the code from rarog pair or from a paired device. The image never leaves this device.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Rarog connects directly to your server when it is on the same network. It does not look for other devices.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone turns on only when you tap the microphone button to dictate, or while you talk with the voice agent. Dictation audio goes only to the speech recognition you chose on the “Dictation” screen. Voice agent audio goes to OpenAI, and only after you turn on “Voice Agent” in Settings.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition runs only when you tap the microphone button with “System Dictation” chosen: your speech becomes text in the field. The audio stays on this device when your language has an on-device speech model; otherwise it goes to Apple's speech recognition servers.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>RarogKeychainGroup</key>
	<string>$(AppIdentifierPrefix)ai.rarog.app</string>
	<key>RarogKeychainSharedGroup</key>
	<string>$(AppIdentifierPrefix)ai.rarog.app.shared</string>
	<key>RarogVoiceSoniox</key>
	<string>$(RAROG_VOICE_SONIOX)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIPrefersShowingLanguageSettings</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
