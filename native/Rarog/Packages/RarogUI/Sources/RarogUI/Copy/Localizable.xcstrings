    "dictation.system.summary" : {
      "comment" : "Dictation screen (first-mic sheet, note page and Settings page), system dictation option (Apple speech recognition): description and consent in one. Provider (Apple), what leaves the device (stays on the device when the language has a speech model there, otherwise Apple's servers) and that nothing goes to the Rarog server. No Soniox name: it also stands in builds without the Soniox option.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple speech recognition. The audio stays on this device when your language has a speech model here; otherwise it goes to Apple's servers. Nothing goes to the Rarog server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy Apple. Dźwięk zostaje na urządzeniu, gdy Twój język ma tu model mowy; inaczej idzie do serwerów Apple. Nic nie trafia do serwera Rarog."
          }
        }
      }
    },
    "dictation.system.title" : {
