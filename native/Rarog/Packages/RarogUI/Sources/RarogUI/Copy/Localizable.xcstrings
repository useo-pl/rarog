      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultracode applies only to this session: Claude plans a workflow for every task, so each turn costs more tokens and gets you to the plan limit sooner. To turn it off, choose “No” in the same “Model and Effort” sheet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultracode działa tylko w tej sesji: Claude planuje workflow przy każdym zadaniu, więc tura kosztuje więcej tokenów i szybciej zbliża limit. Wyłączysz je w tym samym dymku „Model i effort”, wybierając „Nie”."
          }
        }
      }
    },
