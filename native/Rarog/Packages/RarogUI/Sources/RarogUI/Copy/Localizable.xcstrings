        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie da się odczytać ustawień rejestru na tym urządzeniu. Połączenia działają; parowanie przez iroh je odnowi."
          }
        }
      }
    },
    "pairing.relayStatus.unreachable" : {
      "comment" : "Parowanie i ustawienia serwera › Ustawienia → Serwer → sekcja rejestru relaya iroh (stan apki w rejestrze relaya Rarog). Stan: rejestr nie odpowiada (sieć albo błąd po jego stronie).",
