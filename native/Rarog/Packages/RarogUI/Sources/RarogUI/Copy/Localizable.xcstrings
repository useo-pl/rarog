    "pairing.relayStatus.removed" : {
      "comment" : "Parowanie i ustawienia serwera › Ustawienia → Serwer → sekcja rejestru relaya iroh (stan apki w rejestrze relaya Rarog). Stan po przycisku pairing.relayRemove: rejestr potwierdził usunięcie.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
