    "dictation.soniox.setup.run" : {
      "comment" : "Dictation screen (first-mic sheet, note page and Settings page), Soniox through the user's server option: step 2 under the \"not available\" state; the server commands (rarog dictation set-key, rarog restart) stand under it, written by the app, not in this text.",
      "extractionState" : "manual",
      "localizations" : {
