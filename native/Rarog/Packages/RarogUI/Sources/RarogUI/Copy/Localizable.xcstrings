    "pairing.newDeviceNotice" : {
      "comment" : "Parowanie i ekran „Serwer” › Notka o nowym urządzeniu (trwały ślad), chwila nieznana. Parametry: 1. etykieta urządzenia (identyfikator, bez tłumaczenia), 2. kto wydał kod (pairing.newDeviceNotice.from*).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New device: %1$@, %2$@. If this wasn't you, revoke it on the Mac: rarog devices."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe urządzenie: %1$@, %2$@. Jeśli to nie Ty, odepnij je na Macu: rarog devices."
          }
        }
      }
    },
