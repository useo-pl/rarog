    "dictation.soniox.setup.key" : {
      "comment" : "Dictation screen (first-mic sheet, note page and Settings page), Soniox through the user's server option: step 1 under the \"not available\" state, for the person who runs the server. Keep console.soniox.com as is; the project must be in the EU region.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a project in the EU region at console.soniox.com and copy its API key."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załóż projekt w regionie UE na console.soniox.com i skopiuj jego klucz API."
          }
        }
      }
    },
    "dictation.soniox.setup.link" : {
      "comment" : "Dictation screen (first-mic sheet, note page and Settings page), Soniox through the user's server option: link button to the Soniox console (console.soniox.com) under the steps.",
