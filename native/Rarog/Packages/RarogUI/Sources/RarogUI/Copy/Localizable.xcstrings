    "newSession.startModeHint.acceptEdits" : {
      "comment" : "Nowa sesja i wznawianie › Formularz. Zdanie pod przełącznikiem — dla auto jest ostrzeżeniem od pierwszej klatki. Treść według dokumentacji trybów CLI: reguły `allow` i `ask` działają w każdym trybie, więc zdania nie obiecują „pyta o wszystko” ani „nie pyta nigdy”. Jedna linia na iPadzie: zdanie ma być czytane, nie omijane. Wariant: przypadek acceptEdits.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edits files without asking (also mkdir, mv, cp). Asks before other commands."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pytania edytuje pliki (także mkdir, mv, cp). O inne komendy pyta."
          }
        }
      }
    },
    "newSession.startModeHint.auto" : {
      "comment" : "Nowa sesja i wznawianie › Formularz. Zdanie pod przełącznikiem — dla auto jest ostrzeżeniem od pierwszej klatki. Treść według dokumentacji trybów CLI: reguły `allow` i `ask` działają w każdym trybie, więc zdania nie obiecują „pyta o wszystko” ani „nie pyta nigdy”. Jedna linia na iPadzie: zdanie ma być czytane, nie omijane. Wariant: przypadek auto.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent acts on its own. A classifier blocks risky actions."
