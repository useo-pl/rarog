    "dictation.failure.appleServerUnreachable" : {
      "comment" : "Dyktowanie › Wiersz dyktowania pod polem wiadomości i w notatce: rozpoznawanie mowy Apple (trasa systemowa). Wariant: język bez modelu na urządzeniu, a serwery rozpoznawania mowy Apple nieosiągalne.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach Apple's speech recognition servers. Check the internet connection and try again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia z serwerami rozpoznawania mowy Apple. Sprawdź internet i spróbuj ponownie."
          }
        }
      }
    },
    "dictation.failure.assetsMissing" : {
      "comment" : "Dyktowanie › Wiersz dyktowania pod polem wiadomości i w notatce: rozpoznawanie mowy Apple (trasa systemowa). Wariant: brak zasobów rozpoznawania mowy na urządzeniu.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device doesn't have the speech model for this language yet. Try again later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie nie ma jeszcze modelu mowy dla tego języka. Spróbuj ponownie później."
          }
        }
      }
    },
    "dictation.failure.dictationDisabled" : {
      "comment" : "Dyktowanie › Wiersz dyktowania pod polem wiadomości i w notatce: rozpoznawanie mowy Apple (trasa systemowa). Wariant: dyktowanie (albo Siri) wyłączone w ustawieniach systemu; bez przycisku, bo skrót iOS otwiera tylko stronę apki. Ścieżka i nazwa przełącznika jak w pomocy Apple („Enable Dictation”, pl „Włącz dyktowanie”).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictation is turned off on this device. Turn it on in Settings: General → Keyboard → Enable Dictation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyktowanie jest wyłączone na tym urządzeniu. Włącz je w Ustawieniach: Ogólne → Klawiatura → Włącz dyktowanie."
          }
        }
      }
    },
    "dictation.failure.engineFailed" : {
      "comment" : "Dyktowanie › Wiersz dyktowania pod polem wiadomości i w notatce: rozpoznawanie mowy Apple (trasa systemowa). Wariant: błąd silnika rozpoznawania; tekst, który zdążył przyjść, zostaje w polu.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition failed. Try again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy nie zadziałało. Spróbuj ponownie."
          }
        }
      }
    },
    "dictation.failure.localeUnsupported" : {
      "comment" : "Dyktowanie › Wiersz dyktowania pod polem wiadomości i w notatce: rozpoznawanie mowy Apple (trasa systemowa). Wariant: język apki bez rozpoznawania mowy Apple na tym urządzeniu; „Settings → Dictation” to sekcja Ustawień apki.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple speech recognition doesn't support the app's language on this device. You can choose another way to dictate in Settings → Dictation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy Apple nie obsługuje języka apki na tym urządzeniu. Inny sposób dyktowania wybierzesz w Ustawieniach → Dyktowanie."
          }
        }
      }
    },
    "dictation.failure.speechDenied" : {
      "comment" : "Dyktowanie › Wiersz dyktowania pod polem wiadomości i w notatce: rozpoznawanie mowy Apple (trasa systemowa). Wariant: brak zgody na rozpoznawanie mowy; obok przycisk „Settings” (strona apki w Ustawieniach iOS), jak przy odmowie mikrofonu.",
