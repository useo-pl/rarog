    "cards.approvalKeyboardSpoken" : {
      "comment" : "Karty decyzji › Dialog w terminalu. VoiceOver z podłączoną klawiaturą: aktywacja „Zatwierdź\" nie zatwierdza, bo VO+Spacja i dwukrotne stuknięcie przychodzą tą samą akcją (`ApprovalGate`).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a keyboard connected, VoiceOver can't allow this: Rarog can't tell a key press from a tap. Disconnect the keyboard or allow it in the terminal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy podłączonej klawiaturze VoiceOver nie zatwierdza — klawisza nie odróżnię od stuknięcia. Odłącz klawiaturę albo zatwierdź w terminalu."
          }
        }
      }
    },
