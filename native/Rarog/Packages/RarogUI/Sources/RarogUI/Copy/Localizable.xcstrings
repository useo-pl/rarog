        }
      }
    },
    "pairing.relayStatus.storage" : {
      "comment" : "Parowanie i ustawienia serwera › Ustawienia → Serwer → sekcja rejestru relaya iroh (stan apki w rejestrze relaya Rarog). Stan: zapis rejestru w pęku kluczy urządzenia jest nieczytelny.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
