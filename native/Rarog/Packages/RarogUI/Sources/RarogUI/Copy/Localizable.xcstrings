    "header.modelChangeWarning" : {
      "comment" : "Nagłówek sesji › Pigułka modelu i arkusz. Skutek globalny `/model` — to samo zdanie co `MODEL_CHANGE_WARNING` serwera. Słyszy je czytnik przy wyborze i przy „Zatwierdź\"; na ekranie nie stoi.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The change goes to the pane as the “/model” command, and Claude Code saves it in the account settings: new sessions, including those started in the terminal, will use this model from now on. Rarog won't restore the previous value."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana leci do panelu jako polecenie „/model\", a Claude Code zapisuje ją w ustawieniach konta: nowe sesje — także zakładane w terminalu — ruszą od tej chwili na tym modelu. Rarog nie przywróci poprzedniej wartości."
          }
        }
      }
    },
    "header.modelChanging" : {
      "comment" : "Session header › Model pill and sheet. The sheet says it instead of offering Apply while a model and effort change is still on its way to the session.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A model or effort change is on its way. Wait for the session to show it."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana modelu albo effortu jest w drodze — poczekaj, aż sesja ją pokaże."
          }
        }
      }
    },
    "header.modelDismiss" : {
