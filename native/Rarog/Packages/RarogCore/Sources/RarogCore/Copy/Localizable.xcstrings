{
  "sourceLanguage" : "en",
  "strings" : {
    "core.noConnection" : {
      "comment" : "Odmowy bramek rdzenia.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach the server. Try again in a moment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia z serwerem — spróbuj za chwilę."
          }
        }
      }
    },
    "core.unsupportedSession" : {
      "comment" : "Odmowy bramek rdzenia.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version of the app doesn't support this session. Update the app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja apki nie obsługuje tej sesji — zaktualizuj apkę."
          }
        }
      }
    },
    "core.updateApp" : {
      "comment" : "Odmowy bramek rdzenia.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server is newer than this version of the app. Update the app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer jest nowszy niż ta wersja apki — zaktualizuj apkę."
          }
        }
      }
    },
    "core.updateServer" : {
      "comment" : "Core gate refusals. The app is newer than the server (the server has a lower protocol): the refusal of a change and the incompatibility banner. Parameters: the first %@ is the server update command (not translated: rarog update), the second %@ the full chain with the install for a server without that command (not translated: npm i -g @rarog/server@latest && rarog update). The parenthesis ends the sentence, no period after it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is newer than the server. Update the server: %@ (a server without this command: %@)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka jest nowsza niż serwer — zaktualizuj serwer: %@ (serwer bez tej komendy: %@)"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
