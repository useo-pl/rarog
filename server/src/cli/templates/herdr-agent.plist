<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    herdr for Rarog: launchd starts `herdr server` once after the user logs in, in the gui/$UID domain. The file comes
    from the template server/src/cli/templates/herdr-agent.plist through `rarog setup`, which never overwrites it.
    No KeepAlive: a herdr already running on the same socket makes this start exit with code 1 and nothing else, and
    `herdr server stop` stops herdr. Remove: rm this file (from the next login), or `launchctl bootout` of the label
    (at once; it stops herdr and closes its panes).
  -->
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HERDR}}</string>
    <string>server</string>
  </array>
{{ENVIRONMENT}}
  <key>WorkingDirectory</key>
  <string>{{HOME}}</string>
  <!-- Start on load (= after login), once. -->
  <key>RunAtLoad</key>
  <true/>
  <!-- `Interactive`: herdr runs the panes a person works in. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <!-- herdr server output; launchd appends to it. -->
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
