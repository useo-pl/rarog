[Unit]
Description=iroh-relay 1.4.1 (relay.rarog.ai)
Documentation=https://github.com/n0-computer/iroh/tree/v1.4.1/iroh-relay
# Bez pliku konfiguracji iroh-relay startuje z wartościami domyślnymi, czyli bez TLS i otwarty dla każdego.
AssertPathExists=/etc/iroh-relay/config.toml
# tc jest warunkiem startu: Requires= ciągnie relay-tc.service, a ExecStartPre sprawdza samo drzewo qdisc
# (relay-tc.service po RemainAfterExit= zostaje active także wtedy, gdy ktoś zdejmie qdisc w biegu).
Requires=relay-tc.service
After=relay-tc.service network-online.target nftables.service relay-access.service
# Adapter haka przez Wants=, nie BindsTo=: śmierć adaptera nie zatrzymuje relaya (żywe połączenia trwają, nowe
# dostają odmowę do restartu adaptera, ok. 1,5 s). Zatrzymanie przez zależność nie uruchamia Restart=, więc
# BindsTo= po tej stronie zostawiłby relay martwy do ręcznego startu. Wiązanie w drugą stronę (stop relaya
# zatrzymuje adapter) trzyma relay-access.service.
Wants=network-online.target relay-access.service

[Service]
User=iroh-relay
Group=iroh-relay
StateDirectory=iroh-relay
StateDirectoryMode=0700
# Klucz certyfikatu i konta ACME w cert_dir: pliki 0600, katalogi 0700 (domyślna maska dałaby 0644).
UMask=0077
EnvironmentFile=/etc/iroh-relay/relay.env
Environment=RUST_LOG=info
# Bez kodów ANSI w journald: iroh-relay koloruje dziennik także bez TTY, co psuje grep i alerty.
Environment=NO_COLOR=1
ExecStartPre=+/opt/relay-vps/relay-tc.sh check
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/config.toml
Restart=always
RestartSec=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitNOFILE=65536
MemoryMax=1G
TasksMax=512
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
